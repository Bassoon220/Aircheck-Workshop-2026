.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Keep small example CSV files in Git; ignore common large dataset formats.
sample_data/**/*.parquet
sample_data/**/*.feather
sample_data/**/*.h5
sample_data/**/*.hdf5
sample_data/**/*.zip

# ...but the small committed workshop samples are an exception.
!sample_data/sample-*.parquet

# Original/full datasets kept outside the tracked workshop sample data.
main-data/
data-workshop2025/
# The real workshop files, including the gold labels. Never commit these.
FinalData_AircheckWorkshopSep2026/

# Generated workshop outputs are local by default.
results/*
!results/.gitkeep

# Local secrets and environment settings.
.env
.env.*
!.env.example
# Artifacts the notebooks write when they are run.
notebooks/*.joblib
notebooks/*.pkl
notebooks/*.mol
notebooks/*.csv
notebooks/*.xlsx
notebooks/*.png
notebooks/*.metadata.json

# Activity answer key - kept local, not for participants.
activity-solution.ipynb

# Last year's evaluation notebooks, kept for reference only.
temp/

# Artifacts a notebook writes into the repository root when run from here.
/*.joblib
/*.pkl
/*.mol
/*.csv
/*.png
/*.metadata.json
